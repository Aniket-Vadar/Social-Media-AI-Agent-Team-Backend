# ==============================================================================
# Socialix AI Agent Office - Backend Environment Variables
# ==============================================================================

PROJECT_NAME="Socialix AI Agent Office Backend"
ENVIRONMENT="development"
DEBUG=true

# Database / Supabase (PostgreSQL)
# Find your Supabase Connection String under: Project Settings -> Database -> Connection string -> URI
# Use the direct connection or transaction pooler:
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Supabase API details
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Google Gemini API
GOOGLE_API_KEY="AIzaSy..."
GEMINI_PRO_MODEL="gemini-1.5-pro"
GEMINI_FLASH_MODEL="gemini-1.5-flash"

# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGSMITH_PROJECT="socialix-agents-dev"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Security & Service Secret
SECRET_KEY="super-secret-jwt-key-for-socialix-auth"
AGENT_SERVICE_JWT_SECRET="socialix-agent-jwt-secret-shared-with-bff"

# 100% Free Social Media Gateway (NO CREDIT CARD REQUIRED)
# Option A: Make.com Free Webhook (1,000 free posts/month, 0 card needed)
SOCIAL_WEBHOOK_URL="https://hook.eu1.make.com/your-webhook-id"

# Option B: Direct Meta Instagram Graph API (100% Free from Meta, 0 card needed)
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_ACCOUNT_ID=""

# Option C: Postiz Gateway (if self-hosted)
POSTIZ_API_KEY=""
POSTIZ_BASE_URL="https://my-postiz.onrender.com"
BLOTATO_API_KEY=""
BLOTATO_WEBHOOK_SECRET=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/socialix"
E2B_API_KEY=""
